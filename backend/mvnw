#!/bin/sh
# Maven Wrapper script for Linux/Mac
# ./mvnw clean package -DskipTests

# ========================================
# 이 스크립트는 Maven이 설치되지 않은 환경에서도
# Maven 빌드를 실행할 수 있게 해줍니다.
# Private 서버에서 빌드할 때 사용합니다.
# ========================================

MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
MAVEN_OPTS="${MAVEN_OPTS:--Xmx256m}"

# Maven Wrapper JAR 경로
wrapperJarPath="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
wrapperPropertiesPath="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Maven Wrapper JAR이 없으면 다운로드
if [ ! -f "$wrapperJarPath" ]; then
    wrapperUrl=$(grep 'wrapperUrl' "$wrapperPropertiesPath" | cut -d'=' -f2-)
    echo "Downloading Maven Wrapper..."
    if command -v curl > /dev/null 2>&1; then
        curl -o "$wrapperJarPath" "$wrapperUrl" -f -L
    elif command -v wget > /dev/null 2>&1; then
        wget -O "$wrapperJarPath" "$wrapperUrl"
    fi
fi

# Maven 배포판 URL
distributionUrl=$(grep 'distributionUrl' "$wrapperPropertiesPath" | cut -d'=' -f2-)
MAVEN_HOME="$HOME/.m2/wrapper/dists/$(basename "$distributionUrl" .zip)"

# Maven이 없으면 다운로드 및 설치
if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Maven distribution..."
    mkdir -p "$MAVEN_HOME"
    tmpFile="$(mktemp)"
    if command -v curl > /dev/null 2>&1; then
        curl -o "$tmpFile" "$distributionUrl" -f -L
    elif command -v wget > /dev/null 2>&1; then
        wget -O "$tmpFile" "$distributionUrl"
    fi
    unzip -q "$tmpFile" -d "$MAVEN_HOME"
    rm -f "$tmpFile"
fi

# Maven 실행 파일 찾기
MAVEN_EXEC=$(find "$MAVEN_HOME" -name "mvn" -type f 2>/dev/null | head -1)

if [ -z "$MAVEN_EXEC" ]; then
    echo "Error: Maven executable not found. Please install Maven manually."
    echo "  sudo apt install maven"
    exit 1
fi

# Maven 실행
exec "$MAVEN_EXEC" "$@"
